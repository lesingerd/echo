<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Echo</AssemblyName>
    <RootNamespace>EchoTray</RootNamespace>
    <ApplicationIcon>assets\echo.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <Product>Echo</Product>
    <AssemblyTitle>Echo</AssemblyTitle>
    <Description>Tray tool that types the clipboard into the next window you click.</Description>
    <Version>1.0.0</Version>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project sits at the repository root, so its default globs would otherwise pull in
         the sources of the projects under tests/ and tools/. -->
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <None Remove="tests/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tests/**" />
    <EmbeddedResource Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Echo's types are internal; the test projects see them rather than linking the sources. -->
    <InternalsVisibleTo Include="Echo.Tests" />
    <InternalsVisibleTo Include="Echo.InteractiveTests" />
  </ItemGroup>

</Project>
